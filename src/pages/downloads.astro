---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Downloads & Dokumente | DJK Köln-Bocklemünd 1967 e.V."
  description="Lade wichtige Vereinsdokumente herunter: Aufnahmeantrag, Vereinssatzung, Protokolle der Jahreshauptversammlung und Ordnungen."
>
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight">Dokumente & Downloads</h1>
      <p class="mt-4 text-slate-300 max-w-xl mx-auto">
        Hier findest du alle offiziellen Formulare, Protokolle und Ordnungen der DJK Köln-Bocklemünd 1967 e.V.
      </p>
    </div>
  </section>

  <section class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-6">
      <!-- Aufnahmeantrag -->
      <div class="bg-gradient-to-r from-white via-white to-emerald-50/50 rounded-2xl p-6 border border-emerald-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:shadow-md transition">
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 mb-2">
            Mitgliedschaft
          </span>
          <h3 class="text-xl font-bold text-slate-900">Aufnahmeantrag DJK Köln-Bocklemünd 1967 e.V.</h3>
          <p class="text-sm text-slate-600 mt-1">
            Das offizielle Anmeldeformular für alle Sportarten (Tennis TG Grün-Weiß, Badminton, Turnen, TT).
          </p>
        </div>
        <a
          href="/downloads/31a958_7cdb7433e6464e1b8f8232d924b5c91f.pdf"
          target="_blank"
          download
          class="px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition flex items-center gap-2 flex-shrink-0 shadow-sm"
        >
          📄 PDF Herunterladen
        </a>
      </div>

      <!-- Protokoll JHV -->
      <div class="bg-gradient-to-r from-white via-white to-slate-50/80 rounded-2xl p-6 border border-emerald-100 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:border-emerald-300 hover:shadow-md transition">
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 mb-2">
            Vereinsleben
          </span>
          <h3 class="text-lg font-bold text-slate-900">Protokoll der Jahreshauptversammlung 2026</h3>
          <p class="text-sm text-slate-600 mt-1">
            Bericht und Beschlüsse der letzten Mitgliederversammlung der DJK Köln-Bocklemünd.
          </p>
        </div>
        <a
          href="/downloads/31a958_199ae17dbf894c999ddfc2d6c9b0072e.pdf"
          target="_blank"
          download
          class="px-5 py-2.5 rounded-xl bg-slate-800 text-white font-semibold hover:bg-slate-700 transition flex items-center gap-2 flex-shrink-0 shadow-sm"
        >
          📄 PDF Herunterladen
        </a>
      </div>

      <!-- Satzung & Jugendordnung -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 mb-2">
            Ordnungen
          </span>
          <h3 class="text-lg font-bold text-slate-900">Vereinssatzung & Beitragsordnung</h3>
          <p class="text-sm text-slate-600 mt-1">
            Rechtliche Grundlagen, Mitgliedsbeiträge und Satzung des Gesamtvereins.
          </p>
        </div>
        <a
          href="/downloads/31a958_75155a6151f441e5b44b7111f6ab707a.pdf"
          target="_blank"
          download
          class="px-5 py-2.5 rounded-xl bg-slate-800 text-white font-semibold hover:bg-slate-700 transition flex items-center gap-2 flex-shrink-0"
        >
          📄 PDF Herunterladen
        </a>
      </div>
    </div>
  </section>
</MainLayout>
