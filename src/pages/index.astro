---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import tennisplatzImg from '../assets/images/tennisplatz.jpg';
---

<MainLayout>
  <!-- Hero Section mit Originalfoto der Anlage & subtiler dynamischer Bewegung -->
  <section class="relative bg-slate-900 text-white overflow-hidden py-20 lg:py-28">
    <!-- Dynamischer Hintergrund: Sanfter Ken-Burns-Effekt -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="hero-bg-animate w-full h-full opacity-35">
        <Image
          src={tennisplatzImg}
          alt="Tennisanlage Heinrich-Rohlmann-Straße der TG Grün-Weiß Bocklemünd"
          class="w-full h-full object-cover"
          format="webp"
        />
      </div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 mb-6 backdrop-blur">
        🎾 DJK Köln-Bocklemünd 1967 e.V. · TG Grün-Weiß
      </span>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight max-w-4xl mx-auto leading-tight">
        Mit dem Herz in Bocklemünd – <br /><span class="text-emerald-400">Von Kölnern für Kölner</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-light">
        Dein familiärer Mehrsparten-Sportverein im Kölner Westen. Entdecke unsere idyllische 5-Platz-Tennisanlage an der Heinrich-Rohlmann-Straße, Pickleball, Badminton, Kinderturnen und mehr.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/sportarten"
          class="px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold shadow-lg hover:bg-emerald-500 transition"
        >
          Unsere Sportarten entdecken
        </a>
        <a
          href="/tennis#schnuppern"
          class="px-6 py-3.5 rounded-xl bg-amber-600 text-white font-semibold shadow-lg hover:bg-amber-500 transition"
        >
          Kostenloses Schnuppertraining
        </a>
        <a
          href="/der-verein"
          class="px-6 py-3.5 rounded-xl bg-white/10 text-white font-semibold border border-white/20 hover:bg-white/20 backdrop-blur transition"
        >
          Über den Verein
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Info Bar (Die 3 wichtigsten Besucherfragen) -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center md:text-left divide-y md:divide-y-0 md:divide-x divide-slate-200">
        <div class="flex items-center gap-4 px-4 pt-4 md:pt-0">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl flex-shrink-0">
            📍
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-slate-500">Tennis-Standort</div>
            <div class="text-sm font-bold text-slate-900">Heinrich-Rohlmann-Str., 50829 Köln</div>
            <div class="text-xs text-slate-500">5 Sandplätze & gemütliches Clubhaus</div>
          </div>
        </div>

        <div class="flex items-center gap-4 px-4 pt-4 md:pt-0">
          <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-2xl flex-shrink-0">
            🆓
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-slate-500">Für Einsteiger</div>
            <div class="text-sm font-bold text-slate-900">Kostenloses Schnuppertraining</div>
            <div class="text-xs text-slate-500">Für Kinder, Jugendliche & Erwachsene</div>
          </div>
        </div>

        <div class="flex items-center gap-4 px-4 pt-4 md:pt-0">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-2xl flex-shrink-0">
            🎾
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-slate-500">Gastspieler</div>
            <div class="text-sm font-bold text-slate-900">Gäste herzlich willkommen</div>
            <div class="text-xs text-slate-500">Faire Platzgebühren & Online-Infos</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sparten & Sportangebote Grid -->
  <section class="py-16 bg-slate-50 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">Vielfalt in Bocklemünd</span>
      <h2 class="text-3xl font-extrabold text-slate-900 mt-1">Unsere Sportarten im Überblick</h2>
      <p class="text-slate-600 mt-2 max-w-xl mx-auto">
        Ob Leistungssport im Ligabetrieb oder entspannter Freizeitsport für die ganze Familie – finde deine Sportart bei der DJK Bocklemünd.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Tennis Card -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl mb-4">
            🎾
          </div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 mb-2">
            TG Grün-Weiß
          </span>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Tennis</h3>
          <p class="text-sm text-slate-600 mb-4">
            5 rote Ascheplätze, Clubhaus „met Hätz“ und reger Spielbetrieb im TVM (Damen, 1./2. Herren, Altersklassen 30/40/50/70 und Jugend).
          </p>
        </div>
        <a href="/tennis" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 inline-flex items-center gap-1 mt-4">
          Zur Tennis-Sparte &rarr;
        </a>
      </div>

      <!-- Pickleball & Racketsport -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-2xl mb-4">
            🏓
          </div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 mb-2">
            Trendsport
          </span>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Pickleball & Badminton</h3>
          <p class="text-sm text-slate-600 mb-4">
            Erlebe Pickleball, das rasante Racket-Spiel für jedes Alter! Dazu unsere gesellige Badminton-Gruppe mit wöchentlichem Training.
          </p>
        </div>
        <a href="/sportarten" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 inline-flex items-center gap-1 mt-4">
          Trainingszeiten entdecken &rarr;
        </a>
      </div>

      <!-- Turnen & Fitness -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-2xl mb-4">
            🤸
          </div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 mb-2">
            Familie & Gesundheit
          </span>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Turnen & Tischtennis</h3>
          <p class="text-sm text-slate-600 mb-4">
            Frühförderung im Eltern-Kind-Turnen, aktive Ballgymnastik und Tischtennis-Vereinsturniere in unserer Halle am Wilhelm-Löhers-Platz.
          </p>
        </div>
        <a href="/sportarten" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 inline-flex items-center gap-1 mt-4">
          Alle Gruppen anzeigen &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Gemeinschafts- & Mitmach-Banner -->
  <section class="py-16 bg-emerald-700 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-extrabold">Werde Teil unserer Vereinsfamilie</h2>
      <p class="mt-4 text-emerald-100 max-w-2xl mx-auto text-lg">
        Die DJK Bocklemünd lebt von ihren Mitgliedern und engagierten Ehrenamtlichen. Lade dir direkt deinen Aufnahmeantrag herunter oder schnuppere unverbindlich rein!
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/downloads"
          class="px-6 py-3 rounded-xl bg-white text-emerald-800 font-bold hover:bg-emerald-50 transition shadow"
        >
          Aufnahmeantrag herunterladen (PDF)
        </a>
        <a
          href="/kontakt"
          class="px-6 py-3 rounded-xl bg-emerald-800 text-white font-semibold border border-emerald-600 hover:bg-emerald-900 transition"
        >
          Fragen? Kontakt aufnehmen
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Sanfte, filmische Bewegung (Ken-Burns-Effekt) */
  @keyframes heroKenBurns {
    0% {
      transform: scale(1) translate(0%, 0%);
    }
    50% {
      transform: scale(1.08) translate(-1.5%, -1%);
    }
    100% {
      transform: scale(1) translate(0%, 0%);
    }
  }

  .hero-bg-animate {
    animation: heroKenBurns 24s ease-in-out infinite alternate;
    will-change: transform;
    transform-origin: center center;
  }

  /* Barrierefreiheit: Bewegung stoppen bei reduzierter Bewegung */
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-animate {
      animation: none;
      transform: none;
    }
  }
</style>
