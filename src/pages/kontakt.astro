---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Kontakt & Anfahrt | DJK Köln-Bocklemünd 1967 e.V."
  description="Kontaktdaten, Adressen und Anfahrt zur Tennisanlage (Heinrich-Rohlmann-Straße) und Sporthalle (Wilhelm-Löhers-Platz) der DJK Bocklemünd."
>
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">Kontakt & Anfahrt</h1>
      <p class="mt-4 text-slate-300 max-w-xl mx-auto font-light">
        Hast du Fragen zur Mitgliedschaft, zu den Sportarten oder zum Schnuppertraining? Melde dich gerne bei uns!
      </p>
    </div>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Standorte & Adressen -->
      <div>
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Unsere Sportstätten</h2>

        <div class="space-y-6">
          <!-- Tennisanlage -->
          <div class="bg-gradient-to-br from-white via-emerald-50/30 to-emerald-50/60 rounded-3xl p-7 border border-emerald-200/80 shadow-sm">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 mb-2">
              Tennis & TG Grün-Weiß
            </span>
            <h3 class="text-xl font-bold text-slate-900">Tennisanlage Heinrich-Rohlmann-Straße</h3>
            <p class="text-sm text-slate-600 mt-2">
              Heinrich-Rohlmann-Straße<br />
              50829 Köln-Bocklemünd
            </p>
            <p class="text-xs text-slate-500 mt-3">
              5 Ascheplätze, Clubhaus mit Terrasse, Umkleiden. Parkmöglichkeiten entlang der Straße vorhanden.
            </p>
          </div>

          <!-- Hauptstandort / Halle -->
          <div class="bg-gradient-to-br from-white via-emerald-50/20 to-teal-50/40 rounded-3xl p-7 border border-emerald-100 shadow-sm">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 mb-2">
              Hauptadresse & Halle
            </span>
            <h3 class="text-xl font-bold text-slate-900">Sporthalle Wilhelm-Löhers-Platz</h3>
            <p class="text-sm text-slate-600 mt-2">
              Wilhelm-Löhers-Platz 4<br />
              50829 Köln-Bocklemünd
            </p>
            <p class="text-xs text-slate-500 mt-3">
              Für Badminton, Eltern-Kind-Turnen, Ballgymnastik und Tischtennis.
            </p>
          </div>
        </div>
      </div>

      <!-- Kontaktformular -->
      <div class="bg-white/95 rounded-3xl p-8 border border-emerald-100 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-900 mb-2">Nachricht senden</h2>
        <p class="text-sm text-slate-600 mb-6">
          Fülle einfach das Formular aus – wir leiten deine Anfrage an den passenden Ansprechpartner weiter.
        </p>

        <form class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">
              Dein Name
            </label>
            <input
              type="text"
              required
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-600"
              placeholder="Vor- und Nachname"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">
              E-Mail-Adresse
            </label>
            <input
              type="email"
              required
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-600"
              placeholder="name@beispiel.de"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">
              Betreff / Bereich
            </label>
            <select
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white"
            >
              <option value="tennis">Tennis / TG Grün-Weiß (Schnuppern, Gastspieler)</option>
              <option value="pickleball">Pickleball</option>
              <option value="badminton">Badminton</option>
              <option value="turnen">Turnen & Gymnastik</option>
              <option value="tischtennis">Tischtennis</option>
              <option value="allgemein">Allgemeine Vereinsfrage</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">
              Deine Nachricht
            </label>
            <textarea
              rows="4"
              required
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-600"
              placeholder="Wie können wir dir helfen?"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 rounded-xl bg-emerald-600 text-white font-bold hover:bg-emerald-700 transition shadow"
          >
            Nachricht abschicken
          </button>
        </form>
      </div>
    </div>
  </section>
</MainLayout>
