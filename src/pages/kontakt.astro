---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Kontakt & Anfahrt | DJK Köln-Bocklemünd 1967 e.V."
  description="Kontaktdaten, Adressen und Anfahrt zur Tennisanlage (Heinrich-Rohlmann-Straße) und Sporthalle (Wilhelm-Löhers-Platz) der DJK Bocklemünd."
>
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">Kontakt & Anfahrt</h1>
      <p class="mt-4 text-slate-300 max-w-xl mx-auto font-light">
        Hast du Fragen zur Mitgliedschaft, zu den Sportarten oder zum Schnuppertraining? Melde dich gerne bei uns!
      </p>
    </div>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Standorte & Adressen -->
      <div>
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Unsere Sportstätten</h2>

        <div class="space-y-6">
          <!-- Tennisanlage -->
          <div class="bg-gradient-to-br from-white via-emerald-50/30 to-emerald-50/60 rounded-3xl p-7 border border-emerald-200/80 shadow-sm">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 mb-2">
              Tennis & TG Grün-Weiß
            </span>
            <h3 class="text-xl font-bold text-slate-900">Tennisanlage Heinrich-Rohlmann-Straße</h3>
            <p class="text-sm text-slate-600 mt-2">
              Heinrich-Rohlmann-Straße<br />
              50829 Köln-Bocklemünd
            </p>
            <p class="text-xs text-slate-500 mt-3">
              5 Ascheplätze, Clubhaus mit Terrasse, Umkleiden. Parkmöglichkeiten entlang der Straße vorhanden.
            </p>
          </div>

          <!-- Hauptstandort / Halle -->
          <div class="bg-gradient-to-br from-white via-emerald-50/20 to-teal-50/40 rounded-3xl p-7 border border-emerald-100 shadow-sm">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 mb-2">
              Hauptadresse & Halle
            </span>
            <h3 class="text-xl font-bold text-slate-900">Sporthalle Wilhelm-Löhers-Platz</h3>
            <p class="text-sm text-slate-600 mt-2">
              Wilhelm-Löhers-Platz 4<br />
              50829 Köln-Bocklemünd
            </p>
            <p class="text-xs text-slate-500 mt-3">
              Für Badminton, Eltern-Kind-Turnen, Ballgymnastik und Tischtennis.
            </p>
          </div>
        </div>
      </div>

      <!-- Kontaktformular -->
      <div class="bg-white/95 rounded-3xl p-8 border border-emerald-100 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-2xl font-bold text-slate-900">Nachricht senden</h2>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
              ✉️ Direkter Mailkontakt
            </span>
          </div>
          <p class="text-sm text-slate-600 mb-6">
            Fülle einfach die Felder aus – beim Absenden öffnet sich dein E-Mail-Programm mit vorausgefülltem Text an <strong>info@djk-bocklemuend.de</strong>.
          </p>

          <form id="contact-form" class="space-y-4">
            <div>
              <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">
                Dein Name *
              </label>
              <input
                id="contact-name"
                type="text"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-600"
                placeholder="Vor- und Nachname"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">
                Deine E-Mail-Adresse *
              </label>
              <input
                id="contact-email"
                type="email"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-600"
                placeholder="name@beispiel.de"
              />
            </div>

            <div>
              <label for="contact-category" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">
                Betreff / Bereich
              </label>
              <select
                id="contact-category"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white"
              >
                <option value="Tennis / TG Grün-Weiß (Schnuppern, Medenspiele)">Tennis / TG Grün-Weiß (Schnuppern, Gastspieler, Medenspiele)</option>
                <option value="Pickleball">Pickleball (Pickleball-Cologne)</option>
                <option value="Badminton">Badminton</option>
                <option value="Turnen & Gymnastik">Turnen & Gymnastik (Eltern-Kind, Kinderturnen)</option>
                <option value="Tischtennis">Tischtennis (TTSG DJK-HSV)</option>
                <option value="Allgemeine Vereinsfrage">Allgemeine Vereinsfrage / Mitgliedschaft</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">
                Deine Nachricht *
              </label>
              <textarea
                id="contact-message"
                rows="4"
                required
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-600"
                placeholder="Wie können wir dir helfen? (z. B. Frage zum Schnuppertraining, Beitritt...)"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 rounded-xl bg-emerald-600 text-white font-bold hover:bg-emerald-700 transition shadow flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>✉️ E-Mail-Entwurf öffnen & senden</span>
            </button>
          </form>
        </div>

        <!-- Alternative Direktkopie -->
        <div class="mt-6 pt-6 border-t border-slate-100 bg-slate-50 rounded-2xl p-4">
          <p class="text-xs text-slate-600 mb-2 font-medium">
            Kein Standard-Mailprogramm verknüpft? Schreib uns einfach direkt:
          </p>
          <div class="flex items-center justify-between gap-2 bg-white px-3 py-2 rounded-xl border border-slate-200">
            <span class="text-xs font-mono font-bold text-slate-800 select-all">info@djk-bocklemuend.de</span>
            <button
              id="copy-mail-btn"
              type="button"
              class="px-3 py-1 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 hover:bg-emerald-200 transition cursor-pointer"
            >
              Kopieren 📋
            </button>
          </div>
          <p id="copy-status" class="text-[11px] text-emerald-700 font-semibold mt-1.5 hidden">
            ✓ E-Mail-Adresse in die Zwischenablage kopiert!
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    function setupContactForm() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const copyBtn = document.getElementById('copy-mail-btn');
      const copyStatus = document.getElementById('copy-status');

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();

          const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
          const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
          const categorySelect = document.getElementById('contact-category') as HTMLSelectElement | null;
          const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

          const name = nameInput?.value.trim() || '';
          const email = emailInput?.value.trim() || '';
          const category = categorySelect?.value || 'Anfrage';
          const message = messageInput?.value.trim() || '';

          const subject = encodeURIComponent(`Anfrage DJK Bocklemünd: ${category} (von ${name})`);
          const body = encodeURIComponent(
            `Hallo DJK Köln-Bocklemünd 1967 e.V.,\n\n` +
            `Bereich: ${category}\n` +
            `Name: ${name}\n` +
            `E-Mail: ${email}\n\n` +
            `Nachricht:\n${message}\n\n` +
            `Viele Grüße,\n${name}`
          );

          window.location.href = `mailto:info@djk-bocklemuend.de?subject=${subject}&body=${body}`;
        });
      }

      if (copyBtn && copyStatus) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('info@djk-bocklemuend.de');
            copyStatus.classList.remove('hidden');
            copyBtn.textContent = 'Kopiert! ✓';
            setTimeout(() => {
              copyBtn.textContent = 'Kopieren 📋';
              copyStatus.classList.add('hidden');
            }, 3000);
          } catch (err) {
            console.error('Kopieren fehlgeschlagen', err);
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupContactForm);
    } else {
      setupContactForm();
    }
    document.addEventListener('astro:page-load', setupContactForm);
  </script>
</MainLayout>
