<MainLayout title="Impressum | DJK Köln-Bocklemünd 1967 e.V.">
  <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-slate-900 mb-6">Impressum</h1>
    
    <div class="prose prose-slate max-w-none text-sm space-y-4 text-slate-700">
      <h2 class="text-xl font-bold text-slate-900">Angaben gemäß § 5 DDG</h2>
      <p>
        <strong>DJK Köln-Bocklemünd 1967 e.V.</strong><br />
        Wilhelm-Löhers-Platz 4<br />
        50829 Köln
      </p>

      <h2 class="text-xl font-bold text-slate-900">Vertreten durch den Vorstand</h2>
      <p>
        DJK Köln-Bocklemünd 1967 e.V.<br />
        E-Mail: info@djk-bocklemuend.de
      </p>

      <h2 class="text-xl font-bold text-slate-900">Tennisabteilung / TG Grün-Weiß</h2>
      <p>
        Tennisanlage Heinrich-Rohlmann-Straße<br />
        50829 Köln<br />
        Mitglied im Tennisverband Mittelrhein (TVM e.V., Vereins-Nr. 2110)
      </p>

      <h2 class="text-xl font-bold text-slate-900">Registereintrag</h2>
      <p>
        Eintragung im Vereinsregister.<br />
        Registergericht: Amtsgericht Köln
      </p>
    </div>
  </section>
</MainLayout>
