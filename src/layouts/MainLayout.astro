---
import { Image } from 'astro:assets';
import djkLogoImg from '../assets/images/djk-logo.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DJK Köln-Bocklemünd 1967 e.V. | Tennis (TG Grün-Weiß) & Breitensport",
  description = "Offizielle Website der DJK Köln-Bocklemünd 1967 e.V. - Tennisanlage mit 5 Sandplätzen an der Heinrich-Rohlmann-Straße, Pickleball, Badminton, Turnen und Tischtennis.",
} = Astro.props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/djk-logo.png" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased font-sans">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-12 h-12 rounded-xl bg-white p-1 border border-slate-200 shadow-sm flex items-center justify-center group-hover:border-emerald-500 transition">
            <Image
              src={djkLogoImg}
              alt="DJK Köln-Bocklemünd 1967 e.V. Logo"
              class="w-full h-full object-contain"
              format="webp"
            />
          </div>
          <div>
            <div class="font-bold text-slate-900 leading-tight">DJK Köln-Bocklemünd</div>
            <div class="text-xs text-emerald-700 font-medium">1967 e.V. · TG Grün-Weiß</div>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-emerald-700 transition">Startseite</a>
          <a href="/sportarten" class="hover:text-emerald-700 transition font-semibold text-slate-800">Sportarten</a>
          <a href="/der-verein" class="hover:text-emerald-700 transition">Der Verein</a>
          <a href="/aktuelles" class="hover:text-emerald-700 transition">Aktuelles</a>
          <a href="/termine" class="hover:text-emerald-700 transition">Termine</a>
          <a href="/kontakt" class="hover:text-emerald-700 transition">Kontakt</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/vereinsshop"
            class="hidden lg:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md border border-emerald-300 text-emerald-800 bg-emerald-50 hover:bg-emerald-100 transition"
          >
            🛍️ Vereinsshop
          </a>
          <a
            href="/keystatic"
            class="hidden sm:inline-flex px-3 py-1.5 text-xs font-semibold rounded-md border border-slate-300 text-slate-700 hover:bg-slate-100 transition"
          >
            CMS Login
          </a>
          <a
            href="/tennis#schnuppern"
            class="hidden sm:inline-flex px-4 py-2 text-sm font-semibold rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm transition"
          >
            Schnuppertraining
          </a>

          <!-- Mobile Hamburger Toggle Button -->
          <button
            id="mobile-menu-toggle"
            type="button"
            class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-600 transition"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label="Hauptmenü öffnen"
          >
            <!-- Burger Icon -->
            <svg id="burger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <!-- Close Icon -->
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu Dropdown -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-2 shadow-lg">
        <a href="/" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition">
          Startseite
        </a>
        <a href="/sportarten" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition">
          Sportarten (inkl. Tennis)
        </a>
        <a href="/der-verein" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition">
          Der Verein & Vorstand
        </a>
        <a href="/aktuelles" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition">
          Aktuelles
        </a>
        <a href="/termine" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition">
          Termine
        </a>
        <a href="/kontakt" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-800 hover:bg-emerald-50 hover:text-emerald-700 transition">
          Kontakt & Anfahrt
        </a>
        <a href="/vereinsshop" class="block px-3 py-2 rounded-lg text-base font-medium text-emerald-700 hover:bg-emerald-50 transition font-semibold">
          🛍️ Vereinsshop (Fan12)
        </a>
        <div class="pt-4 border-t border-slate-100 flex flex-col gap-2">
          <a
            href="/tennis#schnuppern"
            class="text-center w-full px-4 py-2.5 rounded-lg bg-emerald-600 text-white font-semibold shadow-sm hover:bg-emerald-700 transition"
          >
            Schnuppertraining anfragen
          </a>
          <a
            href="/keystatic"
            class="text-center w-full px-3 py-2 text-xs font-semibold rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50 transition"
          >
            Keystatic CMS Login
          </a>
        </div>
      </div>
    </header>

    <script>
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const burgerIcon = document.getElementById('burger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (toggleBtn && mobileMenu && burgerIcon && closeIcon) {
        toggleBtn.addEventListener('click', () => {
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
          mobileMenu.classList.toggle('hidden');
          burgerIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        });

        // Schließen bei Klick auf Link
        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
            toggleBtn.setAttribute('aria-expanded', 'false');
            burgerIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
          });
        });
      }
    </script>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-300 py-12 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-white p-1 flex items-center justify-center flex-shrink-0">
              <Image
                src={djkLogoImg}
                alt="DJK Logo"
                class="w-full h-full object-contain"
                format="webp"
              />
            </div>
            <div class="text-white font-bold text-lg leading-tight">DJK Köln-Bocklemünd 1967 e.V.</div>
          </div>
          <p class="text-sm text-slate-400 mb-4">
            <em>„Mit dem Herz in Bocklemünd – Von Kölnern für Kölner“</em>
          </p>
          <p class="text-xs text-slate-400">
            Wilhelm-Löhers-Platz 4<br />
            50829 Köln
          </p>
        </div>
        <div>
          <div class="text-white font-semibold mb-3">Tennisanlage TG Grün-Weiß</div>
          <p class="text-sm text-slate-400">
            Heinrich-Rohlmann-Straße<br />
            50829 Köln<br />
            5 Sandplätze · Eigenes Clubhaus · TVM-Spielbetrieb
          </p>
        </div>
        <div>
          <div class="text-white font-semibold mb-3">Rechtliches & Service</div>
          <ul class="text-sm space-y-2">
            <li><a href="/vereinsshop" class="text-emerald-400 hover:text-white transition font-medium">🛍️ Vereinsshop (Erima)</a></li>
            <li><a href="/downloads" class="hover:text-white transition">Downloads & Mitgliedsantrag</a></li>
            <li><a href="/impressum" class="hover:text-white transition">Impressum</a></li>
            <li><a href="/datenschutz" class="hover:text-white transition">Datenschutz</a></li>
          </ul>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pt-8 border-t border-slate-800 text-xs text-slate-500 text-center">
        © 2026 DJK Köln-Bocklemünd 1967 e.V. Alle Rechte vorbehalten.
      </div>
    </footer>
  </body>
</html>
